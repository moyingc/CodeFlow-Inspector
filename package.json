{
  "name": "code-function-visualizer",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:zh": "NEXT_PUBLIC_CODEFLOW_LOCALE=zh-CN npm run build",
    "build:en": "NEXT_PUBLIC_CODEFLOW_LOCALE=en-US npm run build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:dev": "tauri dev",
    "desktop:web:build": "vite build --config vite.desktop.config.ts",
    "desktop:build": "tauri build",
    "desktop:build:sidecars": "npm run desktop:lock-sidecars && tauri build --config src-tauri/tauri.sidecars.generated.json",
    "desktop:build:available-sidecars": "npm run desktop:lock-sidecars:partial && tauri build --bundles app --config src-tauri/tauri.sidecars.generated.json",
    "desktop:build:zh": "node scripts/build-localized-desktop.mjs zh-CN",
    "desktop:build:en": "node scripts/build-localized-desktop.mjs en-US",
    "desktop:build:locales": "npm run desktop:build:zh && npm run desktop:build:en",
    "desktop:build:localized": "node scripts/build-localized-desktop.mjs",
    "desktop:checksums": "node scripts/write-release-checksums.mjs",
    "desktop:lock-sidecars": "node scripts/lock-lsp-sidecars.mjs",
    "desktop:prepare-native-sidecars": "node scripts/import-local-native-sidecars.mjs",
    "desktop:prepare-runtime-sidecars": "node scripts/import-local-runtime-sidecars.mjs",
    "desktop:lock-sidecars:partial": "node scripts/lock-lsp-sidecars.mjs --allow-partial",
    "desktop:audit-sidecars": "node scripts/audit-lsp-sidecars.mjs",
    "desktop:lock-debug-sidecars": "node scripts/lock-debug-sidecars.mjs",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern .next --ignore-pattern src-tauri/target --ignore-pattern src-tauri/lsp-sidecars",
    "verify:integrity": "npm run lint && npm test",
    "audit:core-v1": "node scripts/core-v1-acceptance.mjs",
    "verify:core-v1": "node scripts/core-v1-acceptance.mjs --run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "2.9.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "next": "16.2.12",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
